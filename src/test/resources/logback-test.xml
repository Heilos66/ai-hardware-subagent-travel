<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%level %logger{36} - %msg%n</pattern></encoder>
  </appender>
  <!-- WorkflowEvents owns error reporting; Spring AI otherwise repeats each expected failure. -->
  <logger name="org.springframework.ai.chat.model.MessageAggregator" level="OFF"/>
  <root level="WARN"><appender-ref ref="CONSOLE"/></root>
</configuration>
