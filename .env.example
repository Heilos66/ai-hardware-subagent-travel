# In AgentArts, configure these as runtime environment variables.
# Purposes, defaults and required conditions: docs/environment-variables.md
# true (default) uses RAGFlow; false skips retrieval and continues with empty context.
RAGFLOW_ENABLED=true
# Full retrieval URL; choose the private or public endpoint for the runtime network.
RAGFLOW_URL=http://<ragflow-private-host>:9380/api/v1/retrieval
# Public alternative: replace the RAGFLOW_URL above with this value.
# RAGFLOW_URL=http://<ragflow-public-host>:9380/api/v1/retrieval
RAGFLOW_DATASET_ID=e611c8e0c45111f19cb7ff060c22c24e
RAGFLOW_RERANK_ID=bge-reranker-v2-m3@maas-hw@OpenAI-API-Compatible
# false omits rerank_id and rerank_candidates_count, even if the ID is configured.
RAGFLOW_USE_RERANK=true
# Recommended A1 values. Explicit blank or literal null omits each parameter.
# Removing a variable restores the application default (64/128/32), not omission.
RAGFLOW_KNN_TOP_K=64
RAGFLOW_KNN_NUM_CANDIDATES=128
RAGFLOW_RERANK_CANDIDATES_COUNT=32
# Supply the usable Bearer token at runtime; never bake it into the image.
RAGFLOW_API_TOKEN=
# Optional UTF-8 token file; takes precedence and is re-read on every search.
RAGFLOW_API_TOKEN_FILE=
RAGFLOW_TOP_K=3
RAGFLOW_SIMILARITY_THRESHOLD=0.2
RAGFLOW_MIN_SIMILARITY=0.3
# Total seconds across all retrieval attempts, including retry backoff.
RAGFLOW_TIMEOUT=10
# Retries for connection failures and HTTP 408/429/5xx; 0 disables retries.
RAGFLOW_RETRIES=2
# Summary diagnostics are always logged. Enable payloads only when investigating a request.
RAGFLOW_LOG_CONTENT=false
MODEL_LOG_REQUEST=false
# Maximum JSON characters before a log is replaced by a marked preview (256..65536).
DIAGNOSTIC_LOG_MAX_CHARS=16000

CLASSIFIER_URL=http://<classifier-host>:16000/mobilenetv3large
# Supply the usable key; the E1-{kms-...} value in the workflow is not a raw key.
CLASSIFIER_API_KEY=
CLASSIFIER_THRESHOLD=0.7
CLASSIFIER_TIMEOUT=30
# 仅对暂时性分类故障转视觉模型；低置信度始终正常转视觉
CLASSIFIER_FALLBACK_ON_TRANSIENT_ERROR=false
MODEL_TIMEOUT=60
HEARTBEAT_SECONDS=15
MAX_REQUEST_BYTES=16777216
MAX_IMAGE_BYTES=10485760
MAX_CONTEXT_CHARS=16000
# User query and retrieval question limit, counted in Unicode code points.
MAX_QUERY_CHARS=10000
# System-prompt answer limit: Chinese/Japanese characters, English words.
# This does not truncate the streamed output or set model max_tokens.
MAX_RESPONSE_CHARS=200
# Optional comma-separated host restriction for input model_config.endpoint.
MODEL_ALLOWED_HOSTS=
WORKFLOW_ID=wenlv-highcode
WORKFLOW_NAME=文旅逛展

# Spring Boot listens on 0.0.0.0; AgentArts uses port 8080.
PORT=8080
# Optional JVM tuning (the Docker image defaults to this value).
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0
