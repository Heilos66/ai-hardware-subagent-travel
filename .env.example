# In AgentArts, configure these as runtime environment variables.
# A published APIG URL takes precedence over endpoint/project/application composition.
KOOSEARCH_URL=
KOOSEARCH_ENDPOINT=https://your-koosearch-endpoint.example.com
KOOSEARCH_PROJECT_ID=your-project-id
KOOSEARCH_APPLICATION_ID=your-application-id
KOOSEARCH_TEXT_REPO_ID=your-text-repo-id
KOOSEARCH_IMAGE_REPO_ID=your-image-repo-id

# Prefer AppCode if the published API enables APP simple authentication.
KOOSEARCH_APPCODE=
# Or use a project-scoped IAM token. Renew it outside this service before expiry.
KOOSEARCH_TOKEN=
# Optional: mounted UTF-8 token file, re-read on each search to support rotation.
KOOSEARCH_TOKEN_FILE=
KOOSEARCH_TOP_K=3
# Leave thresholds empty to use Koo Search knowledge-base defaults.
KOOSEARCH_TEXT_THRESHOLD=
KOOSEARCH_IMAGE_THRESHOLD=

CLASSIFIER_URL=http://1.95.68.165:16000/mobilenetv3large
# Supply the usable key; the E1-{kms-...} value in the workflow is not a raw key.
CLASSIFIER_API_KEY=
CLASSIFIER_THRESHOLD=0.7
CLASSIFIER_TIMEOUT=30
SEARCH_TIMEOUT=30
MODEL_TIMEOUT=60
HEARTBEAT_SECONDS=15
MAX_REQUEST_BYTES=16777216
MAX_IMAGE_BYTES=10485760
MAX_CONTEXT_CHARS=16000
# Optional comma-separated host restriction for input model_config.endpoint.
MODEL_ALLOWED_HOSTS=
WORKFLOW_ID=wenlv-highcode
WORKFLOW_NAME=文旅逛展

# Spring Boot listens on 0.0.0.0; AgentArts uses port 8080.
PORT=8080
# Optional JVM tuning (the Docker image defaults to this value).
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0
