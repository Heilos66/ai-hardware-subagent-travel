# In AgentArts, configure these as runtime environment variables.
# Knowledge retrieval always uses RAGFlow.
RAGFLOW_URL=http://172.16.0.154:9380/api/v1/retrieval
RAGFLOW_DATASET_ID=e611c8e0c45111f19cb7ff060c22c24e
RAGFLOW_RERANK_ID=bge-reranker-v2-m3@maas-hw@OpenAI-API-Compatible
# Supply the usable Bearer token at runtime; never bake it into the image.
RAGFLOW_API_TOKEN=
# Optional UTF-8 token file; takes precedence and is re-read on every search.
RAGFLOW_API_TOKEN_FILE=
RAGFLOW_TOP_K=3
RAGFLOW_SIMILARITY_THRESHOLD=0.2
RAGFLOW_MIN_SIMILARITY=0.3
# Total seconds across all retrieval attempts, including retry backoff.
RAGFLOW_TIMEOUT=10
# Retries for connection failures and HTTP 408/429/5xx; 0 disables retries.
RAGFLOW_RETRIES=2

CLASSIFIER_URL=http://1.95.152.66:16000/mobilenetv3large
# Supply the usable key; the E1-{kms-...} value in the workflow is not a raw key.
CLASSIFIER_API_KEY=
CLASSIFIER_THRESHOLD=0.7
CLASSIFIER_TIMEOUT=30
MODEL_TIMEOUT=60
HEARTBEAT_SECONDS=15
MAX_REQUEST_BYTES=16777216
MAX_IMAGE_BYTES=10485760
MAX_CONTEXT_CHARS=16000
# Optional comma-separated host restriction for input model_config.endpoint.
MODEL_ALLOWED_HOSTS=
WORKFLOW_ID=wenlv-highcode
WORKFLOW_NAME=文旅逛展

# Spring Boot listens on 0.0.0.0; AgentArts uses port 8080.
PORT=8080
# Optional JVM tuning (the Docker image defaults to this value).
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0
